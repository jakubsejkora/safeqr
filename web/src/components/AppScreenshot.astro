---
import type { Locale } from "../lib/locale";

interface Props {
  screen: "scannerDanger" | "premiumSMS" | "cloud-finished" | "danger-confirmation";
  locale: Locale;
  alt: string;
}

const { screen, locale, alt } = Astro.props;
// The confirmation capture is available only in Czech light and English dark.
const hasLight = screen !== "danger-confirmation" || locale === "cs";
const hasDark = screen !== "danger-confirmation" || locale === "en";
const source = (theme: "light" | "dark") => `/app/ios3-${screen}-${locale}-${theme}.webp`;
---

<picture class="app-screenshot">
  {hasDark && (
    <source media="(prefers-color-scheme: dark)" srcset={source("dark")} type="image/webp" />
  )}
  <img
    src={source(hasLight ? "light" : "dark")}
    width="600"
    height="1304"
    loading="lazy"
    decoding="async"
    alt={alt}
  >
</picture>

<style>
.app-screenshot {
  display: block;
  width: min(100%, 286px);
  margin-inline: auto;
  margin-top: auto;
  padding: 5px;
  border: 1px solid var(--line);
  border-radius: 36px;
  background: #18211e;
  box-shadow: 0 12px 28px #102e2a12;
}
.app-screenshot img {
  display: block;
  width: 100%;
  height: auto;
  border-radius: 30px;
}
</style>
