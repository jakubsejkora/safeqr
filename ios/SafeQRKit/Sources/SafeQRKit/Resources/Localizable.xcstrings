            "state": "translated",
            "value": "We cannot tell who owns this account or whether you owe this payment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neumíme zjistit, komu účet patří ani zda máte tuto platbu opravdu zaplatit."
          }
        }
      }
    },
    "limitation.app": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We cannot verify the app's behavior, permissions or who will handle this link."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neumíme ověřit chování aplikace, její oprávnění ani to, která aplikace odkaz převezme."
          }
        }
      }
    },
    "limitation.bankHandoff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most banking apps need you to scan or import the original code; there is no single link that opens every bank."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Většina bankovních aplikací potřebuje načíst nebo importovat původní kód; jeden společný odkaz pro všechny banky neexistuje."
          }
        }
      }
    },
    "limitation.checksum": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A matching checksum only checks the data, not the honesty of its sender."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Správný kontrolní součet ověřuje jen data, ne poctivost odesílatele."
          }
        }
      }
    },
    "limitation.cryptoNetwork": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The correct network, available balance and final fees have not been checked."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Správná síť, dostupný zůstatek ani konečné poplatky nebyly ověřeny."
          }
        }
      }
    },
    "limitation.cryptoOwner": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We cannot tell who controls this wallet."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neumíme zjistit, kdo tuto peněženku ovládá."
          }
        }
      }
    },
    "limitation.device": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The check on this iPhone works offline. It cannot guarantee safety."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrola v iPhonu funguje bez internetu. Nemůže zaručit bezpečnost."
          }
        }
      }
    },
    "limitation.eSIM": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We cannot verify the plan owner, charges or whether the activation code is still valid."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neumíme ověřit vlastníka tarifu, poplatky ani to, zda aktivační kód ještě platí."
          }
        }
      }
    },
    "limitation.emv": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The merchant's payment network may add fees or require details this device cannot verify."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Platební síť obchodníka může přidat poplatky nebo vyžadovat údaje, které telefon neumí ověřit."
          }
        }
      }
    },
    "limitation.ethereum": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We have not fully verified the Ethereum address."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuto adresu Etherea jsme úplně neověřili."
          }
        }
      }
    },
    "limitation.event": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We cannot verify the organizer or the event's truthfulness."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neumíme ověřit pořadatele ani pravdivost události."
          }
        }
      }
    },
    "limitation.export": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account count covers this code only; an export may be split across several codes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počet účtů platí jen pro tento kód; export může být rozdělen do několika kódů."
          }
        }
      }
    },
    "limitation.identity": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names and contact details in a code can be invented."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jména a kontaktní údaje v kódu mohou být smyšlené."
          }
        }
      }
    },
    "limitation.incomplete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some details could not be read reliably; compare them with the original before continuing."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Některé údaje se nepodařilo spolehlivě přečíst; před pokračováním je porovnejte s originálem."
          }
        }
      }
    },
    "limitation.invoice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An invoice may contain accounting details without a payment account."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Faktura může obsahovat účetní údaje bez čísla účtu pro platbu."
          }
        }
      }
    },
    "limitation.lightning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The invoice checksum is checked, but its signature, expiry and current payment status are not verified."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrolujeme součet dat faktury, ale neověřujeme její podpis, platnost ani stav platby."
          }
        }
      }
    },
    "limitation.location": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A location in a code does not prove what is really at that place."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poloha v kódu nedokazuje, co na daném místě skutečně je."
          }
        }
      }
    },
    "limitation.login": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We cannot verify which device requested this sign-in or whether the code is still valid."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neumíme ověřit, které zařízení o přihlášení požádalo ani zda kód ještě platí."
          }
        }
      }
    },
    "limitation.nestedLimit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the first 32 distinct embedded items were checked."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bylo prověřeno jen prvních 32 různých vložených položek."
          }
        }
      }
    },
    "limitation.numberOwner": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We cannot tell who uses this phone number."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neumíme zjistit, kdo toto telefonní číslo používá."
          }
        }
      }
    },
    "limitation.page": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The check on this iPhone reads the address. It cannot inspect the website or its redirects."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrola v iPhonu přečte adresu. Nemůže prověřit web ani jeho přesměrování."
          }
        }
      }
    },
    "limitation.payBySquare": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PAY by square is detected by its header; its compressed payment details cannot be decoded by this version."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "PAY by square poznáme podle hlavičky; tato verze zatím neumí rozbalit jeho platební údaje."
          }
        }
      }
    },
    "limitation.tariff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your operator's actual price and any existing subscription have not been checked."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skutečná cena u vašeho operátora ani případné běžící předplatné nebyly ověřeny."
          }
        }
      }
    },
    "limitation.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text can contain misleading instructions or formats we do not recognize."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Text může obsahovat klamavé pokyny nebo formáty, které neznáme."
          }
        }
      }
    },
    "limitation.timeZone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code does not specify a time zone; check the event time before saving it."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kód neuvádí časové pásmo; před uložením zkontrolujte čas události."
          }
        }
      }
    },
    "limitation.token": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The token's identity and number of decimal places have not been checked on the network."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Totožnost tokenu ani počet jeho desetinných míst nebyly ověřeny v síti."
          }
        }
      }
    },
    "limitation.tooLarge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the code size was checked; its contents were not inspected."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Byla zkontrolována jen velikost kódu; jeho obsah nebyl prověřen."
          }
        }
      }
    },
    "limitation.wifi": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We cannot verify who runs this network or how it handles your connection."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neumíme ověřit, kdo síť provozuje ani jak zachází s vaším připojením."
          }
        }
      }
    },
