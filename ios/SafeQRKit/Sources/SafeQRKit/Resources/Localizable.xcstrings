    "consequence.appLink": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hands this link to another app, which decides what happens next."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předá tento odkaz jiné aplikaci, která určí další postup."
          }
        }
      }
    },
    "consequence.contact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offers to save %@ in Contacts, which may later make calls from this number look familiar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabídne uložení kontaktu %@, takže budoucí hovor z tohoto čísla může působit důvěryhodně."
          }
        }
      }
    },
    "consequence.crypto": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens a wallet with a payment request; an approved cryptocurrency payment usually cannot be reversed."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevře peněženku s požadavkem na platbu; potvrzenou platbu kryptoměnou obvykle nelze vrátit."
          }
        }
      }
    },
    "consequence.download": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads an application file; installing it may give the app access to your data."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stáhne soubor aplikace; její instalací jí můžete zpřístupnit svá data."
          }
        }
      }
    },
    "consequence.eSIM": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installing this code can activate a mobile plan on a phone; keep it private and check the provider first."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalací tohoto kódu můžete v telefonu aktivovat mobilní tarif; kód nikomu neposílejte a nejdřív ověřte poskytovatele."
          }
        }
      }
    },
    "consequence.email": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepares an email to %@; it is sent only after you tap Send in your email app."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připraví e-mail pro %@; odešle se až po klepnutí na Odeslat v poštovní aplikaci."
          }
        }
      }
    },
    "consequence.emptyExport": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This export contains no accounts to import, so Safe QR does not offer to open it."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V exportu nejsou žádné účty k načtení, proto ho Safe QR nenabízí otevřít."
          }
        }
      }
    },
    "consequence.enterprise": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts installation of an app distributed outside the App Store."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahájí instalaci aplikace šířené mimo App Store."
          }
        }
      }
    },
    "consequence.event": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offers to add %@ to your calendar, including its notes and links."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabídne přidání události %@ do kalendáře včetně poznámek a odkazů."
          }
        }
      }
    },
    "consequence.invoice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies invoice details for use in an accounting or banking app; an invoice is not proof that you owe money."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Údaje z faktury můžete zkopírovat do účetní nebo bankovní aplikace; faktura sama nedokazuje, že máte něco platit."
          }
        }
      }
    },
    "consequence.link": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens %@ in a browser, where the website can see your visit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevře %@ v prohlížeči a provozovatel webu uvidí vaši návštěvu."
          }
        }
      }
    },
    "consequence.location": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the place in Maps; this does not by itself share your current location."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevře místo v Mapách. Tím se neodešle vaše současná poloha."
          }
        }
      }
    },
    "consequence.login.authenticatorExport": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imports private keys for accounts into an authenticator app; sharing this code shares those keys."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahraje soukromé klíče k účtům do ověřovací aplikace; sdílením tohoto kódu sdílíte i tyto klíče."
          }
        }
      }
    },
    "consequence.login.authenticatorSetup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imports a private key into an authenticator app; anyone with a copy can create the same sign-in codes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahraje soukromý klíč do ověřovací aplikace; každý, kdo má jeho kopii, může vytvářet stejné přihlašovací kódy."
          }
        }
      }
    },
    "consequence.login.discord": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approving this code in Discord can sign another device into your account."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Potvrzením tohoto kódu v Discordu můžete přihlásit jiné zařízení ke svému účtu."
          }
        }
      }
    },
    "consequence.login.other": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approving this code may let another device use your account."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Potvrzením tohoto kódu můžete umožnit jinému zařízení používat váš účet."
          }
        }
      }
    },
    "consequence.login.passkey": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approving the sign-in can give the nearby requesting device access to your account."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Potvrzením přihlášení můžete dát blízkému zařízení, které o ně žádá, přístup ke svému účtu."
          }
        }
      }
    },
    "consequence.login.steam": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approving this code in Steam can sign another device into your account."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Potvrzením tohoto kódu ve Steamu můžete přihlásit jiné zařízení ke svému účtu."
          }
        }
      }
    },
    "consequence.login.telegram": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approving this code in Telegram can give another device access to your account and cloud chats."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Potvrzením tohoto kódu v Telegramu můžete dát jinému zařízení přístup k účtu a uloženým chatům."
          }
        }
      }
    },
    "consequence.login.whatsAppWeb": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
