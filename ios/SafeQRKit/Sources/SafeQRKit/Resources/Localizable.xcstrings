    "charge.call": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The number encodes a price of %@ for one connected call."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Číslo udává cenu %@ za jeden spojený hovor."
          }
        }
      }
    },
    "charge.incoming": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One paid incoming message from this service can cost up to %@; charges may repeat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedna placená příchozí zpráva z této služby může stát až %@ a poplatky se mohou opakovat."
          }
        }
      }
    },
    "charge.minute": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The number encodes a price of %@ per minute, so the total grows with the length of the call."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Číslo udává cenu %@ za minutu, takže celková cena roste s délkou hovoru."
          }
        }
      }
    },
    "charge.sms": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending one message to this number can cost up to %@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odeslání jedné zprávy na toto číslo může stát až %@."
          }
        }
      }
    },
    "charge.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This paid service does not reveal a verified price in the number; sending a message may start paid replies."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "U této placené služby neznáme ověřenou cenu; odesláním zprávy můžete spustit placené odpovědi."
          }
        }
      }
    },
    "charge.unknownCall": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a paid-service number, but its actual call price could not be determined."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jde o číslo placené služby, ale skutečnou cenu hovoru se nepodařilo zjistit."
          }
        }
      }
    },
