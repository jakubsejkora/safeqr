    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safe QR uses your camera to read codes and, with your permission, check their surroundings."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Safe QR používá fotoaparát ke čtení kódů a s vaším souhlasem i ke kontrole jejich okolí."
          }
        }
      }
    },
    "NSContactsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safe QR opens a contact for you to review and save only after you confirm."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Safe QR otevře kontakt ke kontrole a uložení až po vašem potvrzení."
          }
        }
      }
    },
    "NSCalendarsWriteOnlyAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safe QR adds an event only after you review and save it."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Safe QR přidá událost, až si ji zkontrolujete a uložíte."
          }
        }
      }
    }
  },
  "version": "1.0"
