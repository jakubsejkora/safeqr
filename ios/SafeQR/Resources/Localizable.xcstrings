          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolte fotoaparát pro čtení kódů. Širší záběr pomůže odhalit přelepený kód nebo něco neobvyklého. Můžete také vybrat fotku."
          }
        }
      }
    },
