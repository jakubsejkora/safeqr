      }
    },
    "With your permission, Safe QR sends the decoded link, language, device score and warning identifiers. If photo checks are on, it also sends a photo and the code’s position in it. For a payment code, this can include the recipient and amount.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With your permission, Safe QR sends the decoded link, language, device score and warning identifiers. If photo checks are on, it also sends a photo and the code’s position in it. For a payment code, this can include the recipient and amount."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "S vaším souhlasem Safe QR odešle přečtený odkaz, jazyk, skóre z iPhonu a označení varování. Při zapnuté kontrole fotek odešle i fotku a polohu kódu v ní. U platebního kódu může jít i o příjemce a částku."
          }
        }
