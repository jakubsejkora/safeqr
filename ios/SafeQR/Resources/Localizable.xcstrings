    "A low score is not a guarantee. Check who you are paying or sharing information with.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A low score is not a guarantee. Check who you are paying or sharing information with."
