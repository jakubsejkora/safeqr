        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nízké skóre není zárukou bezpečí. Ověřte si, komu platíte nebo komu předáváte údaje."
          }
        }
      }
    },
    "A moment to check.\nSomeone to help.": {
