    "Wi-Fi passwords, login and eSIM codes, contacts, events, phone numbers, messages and email details stay on this iPhone. The app sends no location from GPS.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi passwords, login and eSIM codes, contacts, events, phone numbers, messages and email details stay on this iPhone. The app sends no location from GPS."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesla k Wi-Fi, přihlašovací a eSIM kódy, kontakty, události, telefonní čísla, zprávy a e-mailové údaje zůstávají v iPhonu. Aplikace neodesílá polohu z GPS."
          }
